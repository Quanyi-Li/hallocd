# ============================================================
#  halloCD · 环境变量样例
# ============================================================
#  复制成 .env.local（本地）或在 Vercel 项目设置里逐条添加。
#  真实值不要提交、不要打包。

# ---------- 数据库（生产必填）----------
#  没有这一项时，平台自动回落到本地文件存储 —— 能跑，但 Vercel 上不持久。
#
#  驱动用的是 @neondatabase/serverless 的 HTTP 模式，它会 POST 到
#  https://<host>/sql —— 所以需要一个「Neon 兼容的 HTTP /sql 端点」：
#    · Neon                 ✅ 直接可用
#    · Vercel Postgres      ✅ 底层就是 Neon
#    · Supabase / RDS 等    ❌ 只暴露 TCP(5432)，没有 /sql 端点
#  用别家的话，把 lib/db/postgres.ts 里的 neon() 换成 pg（node-postgres），
#  只改那一个文件；业务代码只认 DataStore 接口，不受影响。
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------- PayPal ----------
#  沙盒凭据（开发用）
PAYPAL_CLIENT_ID=你的沙盒 client id
PAYPAL_CLIENT_SECRET=你的沙盒 secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

#  生产：换 live 端点 + 一次性授权的 vault
# PAYPAL_API_BASE=https://api-m.paypal.com
# PAYPAL_VAULT_ID=EAA...

# ---------- Agent API ----------
#  站点主 key（部署方配的那一把）
HALLO_AGENT_API_KEY=hcd_改成你自己的随机串
HALLO_AGENT_API_KEY_LABEL=site

#  管理员密钥 —— 用于自助签发 / 吊销 key
HALLO_AGENT_ADMIN_KEY=hcd_admin_改成你自己的随机串

# ---------- 可选 ----------
#  本地文件存储的根目录（默认 ./data）
# HALLO_AGENT_DATA_DIR=D:\somewhere\data

# ---------- 对象存储（Vercel Blob，生产强烈建议配）----------
#  媒体（录音 / 照片 / 视频）默认是 base64 塞进数据库的 TEXT 列 ——
#  base64 会膨胀 33%，数据库很快被媒体撑爆，备份也变慢。
#  接了 Blob 之后，数据库只留几十字节的路径 + 公开 URL。
#
#  怎么接：
#    1. Vercel 控制台 → Storage → Create Blob Store
#    2. Store access 选 **Public**（素材本身是公开作品）
#    3. Storage 里把这个 store 挂到项目上
#    4. BLOB_READ_WRITE_TOKEN 会自动注入，不用手写
#
#  没配会怎样：
#    媒体退回数据库 base64 存储，功能不缺，但单文件上限 4MB，
#    而且数据库会被媒体撑大。preflight / health 会明确提示。
#
#  本地调试可以手动设（格式必须是四段：vercel_blob_rw_<storeId>）
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

#  客户端直传（>4MB 的文件）需要静态读写令牌才能签 client token ——
#  OIDC 的短期凭据签不了。没配的话大文件传不上去。
#  这两项一般不用手动设，Vercel 会自动注入。
# VERCEL_OIDC_TOKEN=
# BLOB_STORE_ID=

#  只在本地对着 mock 调试时用：把 Blob API 指到本地假服务
#  （scripts/mock-blob-server.mjs --port=3999）
# VERCEL_BLOB_API_URL=http://127.0.0.1:3999
# NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://127.0.0.1:3999

# ---------- GitHub OAuth 登录（可选，v2.8 / G18）----------
#  不配也能用：平台退回「邮箱 + 密码」登录，功能不缺。
#  配了就多一条「用 GitHub 登录」的路 —— 零成本、零发信额度。
#
#  怎么拿凭据：
#    1. 打开 https://github.com/settings/developers → OAuth Apps → New OAuth App
#    2. Authorization callback URL 填：
#         https://你的域名/api/auth/github/callback
#       （本地开发填 http://localhost:3000/api/auth/github/callback）
#    3. 复制 Client ID / Client Secret 到下面两项
#
# GITHUB_CLIENT_ID=Ov23li你的clientid
# GITHUB_CLIENT_SECRET=你的clientsecret

#  回调地址（可选）—— 不配就按访问域名推导。
#  GitHub 是**逐字匹配**的，线上有 www / 非 www 的差别会直接 400，
#  所以线上强烈建议显式写死。
# GITHUB_REDIRECT_URI=https://你的域名/api/auth/github/callback

#  站点根地址（可选）—— 用于推导上面那个回调地址
# NEXT_PUBLIC_SITE_URL=https://你的域名

#  OAuth state 的签名密钥（可选）—— 不配会复用 GITHUB_CLIENT_SECRET。
#  单独配一个的好处：换 GitHub 凭据时不会连带把正在生效的 state 签名换掉。
# AUTH_STATE_SECRET=一串随机字符串

#  只在本地对着 mock 调试时用（scripts/mock-github-oauth.mjs --port=3977）
# GITHUB_OAUTH_BASE=http://127.0.0.1:3977
# GITHUB_API_BASE=http://127.0.0.1:3977

# ---------- 发货通知 · 发信（可选，v2.8 / G17）----------
#  不配也能用：发货通知安静跳过，订单照常完成。
#  配了之后，下单付款完成会给收件人（站内用户）和下单人各发一封「已发货」邮件。
#
#  推荐 Resend：免费额度 3000 封/月 + 100 封/天，1–3 个域名。
#  注册后在 API Keys 里生成 re_ 开头的 key。
# MAIL_API_KEY=re_xxxxxxxx

#  发件人（正式发信必须换成自己的域名 ——
#  onboarding@resend.dev 是 Resend 的测试地址，只能发给自己注册时的邮箱）
# MAIL_FROM=halloCD <hello@你的域名>

#  发信 API 前缀（一般不用改；改它就能对着本地 mock 邮件服务器联调）
#  默认 https://api.resend.com
# MAIL_API_BASE=https://api.resend.com

#  只在本地对着 mock 调试时用（scripts/mock-mail-server.mjs --port=3978）
# MAIL_API_BASE=http://127.0.0.1:3978
# MAIL_API_KEY=mock_mail_key
